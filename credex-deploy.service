[Unit]
Description=Credex Deployment Daemon
Documentation=https://github.com/Great-Sun-Group/credex-core
After=docker.service
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/app/deploy-daemon.sh
Restart=always
RestartSec=10
User=root
Group=root

# Environment variables
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=VIMBISO_CHATSERVER_PATH=/app/vimbiso-chatserver

# Security settings
NoNewPrivileges=false
PrivateTmp=false

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=credex-deploy

# Resource limits
LimitNOFILE=65536
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
