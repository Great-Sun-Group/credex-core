# Neo4j Database URLs
# For local dev, these are set automatically in docker-compose.dev.yml
# For deployed environments, these are configured by terraform
NEO_4J_LEDGER_SPACE_BOLT_URL=bolt://neo4j-ledger:7687
NEO_4J_SEARCH_SPACE_BOLT_URL=bolt://neo4j-search:7687

# External API Configuration
OPEN_EXCHANGE_RATES_API=your_open_exchange_rates_api_key_here

# JWT Configuration
JWT_SECRET=your_random_string

# For authorized clients to generate auth tokens for members on login
CLIENT_API_KEY=your_random_string

# For development environment only (not in prod env)
DEV_ADMIN_KEY=your_random_string
SKIP_RATE_LIMITER_KEY=your_random_string

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Firebase Private Key Here\n-----END PRIVATE KEY-----"

# AWS Development Deploy Configuration
CREDEXCORE_DEV_AWS_ACCESS_KEY=your_aws_access_key_here
CREDEXCORE_DEV_AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=af-south-1
