# Startup license for 6 dev, 3 stage, 3 prod DBs
NEO4J_ENTERPRISE_LICENSE=your_license

NEO_4J_LEDGER_SPACE_BOLT_URL=bolt://your_ledger_space_url_here
NEO_4J_SEARCH_SPACE_USER=your_ledger_space_username
NEO_4J_LEDGER_SPACE_PASS=your_ledger_space_password

# Neo4j Search Space Configuration for dev environments
NEO_4J_SEARCH_SPACE_BOLT_URL=bolt://your_search_space_url_here
NEO_4J_SEARCH_SPACE_USER=your_search_space_username
NEO_4J_SEARCH_SPACE_PASS=your_search_space_password

# External API Configuration
OPEN_EXCHANGE_RATES_API=your_open_exchange_rates_api_key_here

# JWT Configuration
JWT_SECRET=your_random_string

# For authorized clients to generate auth tokens for members on login
CLIENT_API_KEY=your_random_string

# For development environment only (not in prod env)
DEV_ADMIN_KEY=your_random_string
SKIP_RATE_LIMITER_KEY=your_random_string

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Firebase Private Key Here\n-----END PRIVATE KEY-----"

LOG_LEVEL=debug # Options: error, warn, info, http, verbose, debug, silly - Overrides default level based on NODE_ENV

# Sensitive Auth Configuration
PASSWORD_PEPPER=your_password_pepper_here

# WhatsApp Configuration
CREDEX_CORE_WHATSAPP_API_KEY=your_whatsapp_api_key_here
CREDEX_CORE_WHATSAPP_BUSINESS_ID=whats-app-business-id # WhatsApp Business Account ID
CREDEX_CORE_WHATSAPP_PHONE_ID=whats-app-phone-id # WhatsApp Phone Number ID

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=af-south-1
