# Production Environment Variables for Credex Core
# IMPORTANT: Change all default values before deploying!

# Neo4j Aura Configuration - REPLACE WITH YOUR AURA CREDENTIALS
NEO_4J_LEDGER_SPACE_BOLT_URL=neo4j+s://your-ledger-database-id.databases.neo4j.io
NEO_4J_LEDGER_SPACE_USER=neo4j
NEO_4J_LEDGER_SPACE_PASS=your-ledger-database-password

NEO_4J_SEARCH_SPACE_BOLT_URL=neo4j+s://your-search-database-id.databases.neo4j.io
NEO_4J_SEARCH_SPACE_USER=neo4j
NEO_4J_SEARCH_SPACE_PASS=your-search-database-password

# Production Security Keys - GENERATE NEW ONES!
JWT_SECRET_PROD=CHANGE-THIS-prod-jwt-secret-key-very-long-and-random
CLIENT_API_KEY_PROD=CHANGE-THIS-prod-client-api-key-random-string
PASSWORD_PEPPER_PROD=CHANGE-THIS-prod-password-pepper-very-secure
DJANGO_SECRET_PROD=CHANGE-THIS-prod-django-secret-key-very-long-random

# External API Configuration (same as dev, or use production keys)
OPEN_EXCHANGE_RATES_API=8db9eabefc004a6e8fb69c4b6f40196d

# WhatsApp Configuration - PRODUCTION CREDENTIALS
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/
WHATSAPP_ACCESS_TOKEN=your_production_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_production_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ID=your_production_whatsapp_business_account_id
CREDEX_CORE_WHATSAPP_API_KEY=your_production_whatsapp_api_key
CREDEX_CORE_WHATSAPP_BUSINESS_ID=your_production_whatsapp_business_id
CREDEX_CORE_WHATSAPP_PHONE_ID=your_production_whatsapp_phone_id

# Firebase Configuration - PRODUCTION CREDENTIALS
FIREBASE_PROJECT_ID=your-production-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-production-firebase-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Production Firebase Private Key Here\n-----END PRIVATE KEY-----"

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *

# AWS Configuration (if using cloud backups)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=af-south-1
AWS_S3_BACKUP_BUCKET=your-backup-bucket-name

# Deployment Tokens (Generate secure random strings for each)
CREDEX_CORE_DEPLOY_TOKEN=your-secure-credex-core-deploy-token-here-32-chars-minimum
VIMBISO_CHATSERVER_DEPLOY_TOKEN=your-secure-chatserver-deploy-token-here-32-chars-minimum
VIMBISOPAY_DEPLOY_TOKEN=your-secure-mobile-app-deploy-token-here-32-chars-minimum

# Repository Paths (for local deployment)
VIMBISO_CHATSERVER_PATH=../vimbiso-chatserver
CHATSERVER_PORT=3001

# APK Storage Configuration
APK_STORAGE_PATH=./vimbisopay_apk
MAX_APK_SIZE_MB=100

# Deployment Configuration
DEPLOYMENT_BACKUP_RETENTION_DAYS=30
DEPLOYMENT_HEALTH_CHECK_TIMEOUT_MS=30000
