{
  "name": "Credex Core Dev Container",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "saoudrizwan.claude-dev",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker",
        "yzhang.markdown-all-in-one",
        "github.vscode-github-actions",
        "ritwickdey.LiveServer",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "files.autoSave": "afterDelay"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "18"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000],
  "postCreateCommand": "npm install && sudo apt-get update && sudo apt-get install -y docker-compose libnss3 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libasound2 && chmod +x scripts/fetchlogs.js",
  "remoteEnv": {
    "NODE_ENV":"development",
    "AWS_REGION": "af-south-1",
    "AWS_ACCESS_KEY_ID": "${localEnv:CREDEX_CORE_DEV_AWS_ACCESS_KEY_ID}",
    "AWS_SECRET_ACCESS_KEY": "${localEnv:CREDEX_CORE_DEV_AWS_SECRET_ACCESS_KEY}"
  }
}
